# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=3100
# Public origin of the portal, used for CORS and invite/reset links
PORTAL_ORIGIN=http://localhost:5173
# Public base URL of this API, used to build the ASP status webhook URL
API_PUBLIC_URL=http://localhost:3100
# Where this system reaches its own API (the simulated provider's callback).
# Leave unset outside containers; it defaults to 127.0.0.1 on API_PORT.
# API_INTERNAL_URL=http://api:3100

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://uae:uae_dev_password@localhost:5442/uae_einvoice
# Migrations connect as the database owner; the app connects as a
# non-superuser so PostgreSQL row-level security is actually enforced.
DATABASE_APP_URL=postgres://uae_app:uae_app_dev_password@localhost:5442/uae_einvoice

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6389

# --- Object storage (MinIO locally, S3 me-central-1 in production) ---------
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=uae-einvoice-archive
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Object Lock retention in years (UAE statutory minimum is 5)
S3_RETENTION_YEARS=5

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0000000000
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PLATFORM_NAME=UAE E-Invoicing Portal
SUPPORT_EMAIL=support@einvoice.local
SUPPORT_PHONE=
MFA_ISSUER=UAE E-Invoicing

# --- Secret encryption -----------------------------------------------------
# 32-byte key, base64. Encrypts ASP credentials at rest.
# Production: replace this provider with AWS KMS / Secrets Manager.
SECRETS_ENCRYPTION_KEY=ZGV2X29ubHlfMzJfYnl0ZV9rZXlfcmVwbGFjZV9tZSE=

# --- ASP -------------------------------------------------------------------
# MOCK simulates an accredited provider end-to-end with no network calls.
# Switch a tenant to a real driver from the admin panel once one is chosen.
ASP_DEFAULT_DRIVER=MOCK
# Probability (0-1) that the mock ASP rejects an invoice, for exercising the
# rejection path in development. Set to 0 for deterministic acceptance.
ASP_MOCK_REJECT_RATE=0.15
ASP_MOCK_LATENCY_MS=1200

# --- Upload limits ---------------------------------------------------------
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_ROWS=20000
